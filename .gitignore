# 编辑器临时文件
*.swp
*.swo
*.bak
*~
.DS_Store

# Python 字节码
__pycache__/
*.pyc
*.pyo

# 系统生成文件
sway/.config/sway/msg.txt
sway/.config/sway/generated_background.svg

# fcitx5 运行期文件
fcitx5/.config/fcitx5/conf/cached_layouts
fcitx5/.config/fcitx5/conf/*_[A-Za-z0-9]*

# AI 凭据 (本机私密，绝不入库)
zsh/.config/zsh/ai-secrets.sh
ai-secrets.sh
*.secrets.sh

# XDG 规范 (状态/缓存) 镜像，仓库内不需要
# (这些文件原本就在仓库外，仅作记录)
# ~/.local/state/zsh/history
# ~/.cache/zsh/zcompcache

